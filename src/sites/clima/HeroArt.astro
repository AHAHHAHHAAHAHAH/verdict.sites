---
// Behind the home hero: a large hygrometer. The needle starts in the damp zone and settles in the
// comfortable band (40-60%), the job a good dehumidifier does. With reduced motion it is shown
// settled. Kept faint so the headline and the quiz always read first.
const ticks = Array.from({ length: 21 }, (_, i) => -120 + i * 12);
---

<div class="dial" aria-hidden="true">
  <svg viewBox="0 0 600 420" preserveAspectRatio="xMaxYMid slice">
    <g transform="translate(430 250)">
      <circle r="190" fill="none" class="rim"></circle>
      {ticks.map((a, i) => <line x1="0" y1="-170" x2="0" y2={i % 5 === 0 ? -148 : -158} transform={`rotate(${a})`} class="tick" />)}
      <path d="M -122 -122 A 172 172 0 0 1 122 -122" class="band" fill="none"></path>
      <g class="needle">
        <line x1="0" y1="18" x2="0" y2="-140"></line>
      </g>
      <circle r="14" class="hub"></circle>
    </g>
  </svg>
</div>

<style>
  .dial {
    position: absolute;
    inset: 0;
    pointer-events: none;
    mask-image: linear-gradient(90deg, transparent 0%, #000 55%);
    opacity: 0.6;
  }
  svg {
    width: 100%;
    height: 100%;
  }
  .rim {
    stroke: var(--on-ink);
    stroke-opacity: 0.18;
    stroke-width: 2;
  }
  .tick {
    stroke: var(--on-ink);
    stroke-opacity: 0.35;
    stroke-width: 3;
    stroke-linecap: round;
  }
  .band {
    stroke: var(--accent);
    stroke-opacity: 0.35;
    stroke-width: 10;
    stroke-linecap: round;
  }
  .needle line {
    stroke: var(--accent);
    stroke-width: 5;
    stroke-linecap: round;
  }
  .needle {
    transform-box: fill-box;
    transform-origin: 50% 88.61%;
    transform: rotate(8deg);
  }
  .hub {
    fill: var(--accent);
  }
  @media (prefers-reduced-motion: no-preference) {
    .needle {
      animation: settle 3.2s cubic-bezier(0.34, 1.3, 0.64, 1) 0.4s both;
    }
  }
  @keyframes settle {
    from {
      transform: rotate(96deg);
    }
    to {
      transform: rotate(8deg);
    }
  }
  @media (max-width: 58rem) {
    .dial {
      opacity: 0.35;
      mask-image: linear-gradient(180deg, transparent 0%, #000 60%);
    }
  }
</style>
