---
// Mark: a room seen from above, with the robot's coverage path running through it and the
// robot (a lime dot) at the end of the run: the floor, cleaned, and the verdict.
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 28, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M4 20V4h9M20 4v16h-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    <path class="run" d="M7 7.6h10M7 11h10M7 14.4h5.4" fill="none" stroke="var(--accent)" stroke-width="1.8" stroke-linecap="round"></path>
    <circle cx="15.6" cy="14.4" r="1.9" fill="var(--accent)"></circle>
  </svg>
  {
    wordmark && (
      <span class="word">
        <b>Floor</b>Verdict
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .word {
    font: 500 1.08rem/1 var(--f-display);
    font-stretch: 112%;
    letter-spacing: -0.02em;
  }
  .word b {
    font-weight: 800;
  }
  .run {
    stroke-dasharray: 40;
    stroke-dashoffset: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .logo:hover .run {
      animation: sweep 0.9s var(--ease-out);
    }
  }
  @keyframes sweep {
    from {
      stroke-dashoffset: 40;
    }
  }
</style>
