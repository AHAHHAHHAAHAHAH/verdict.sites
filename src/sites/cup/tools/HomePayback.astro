---
import CalcShell from '../../../components/tools/CalcShell.astro';
import CurrencySwitch from './CurrencySwitch.astro';
import Stepper from '../../../components/ui/Stepper.astro';
import Readout from '../../../components/ui/Readout.astro';
import Advanced from '../../../components/ui/Advanced.astro';
import type { Edition } from '../../../i18n/editions';
import type { PerMarket } from '../../../lib/pack';
import { pathFor } from '../../../i18n/routes';
import { t } from '../ui';

interface Props {
  ed: Edition;
}
const { ed } = Astro.props;
const { lang, market } = ed;
const s = t(lang).homePayback;

// Example values only (labelled as such in the UI), never presented as market data.
const examples: PerMarket<Record<string, number>> = {
  us: { machine: 450, beans: 20, dose: 18, extra: 0.3, cafe: 4.5, cups: 2, days: 7, maintenance: 40 },
  gb: { machine: 450, beans: 20, dose: 18, extra: 0.3, cafe: 4.5, cups: 2, days: 7, maintenance: 40 },
  it: { machine: 350, beans: 18, dose: 14, extra: 0.1, cafe: 1.4, cups: 2, days: 7, maintenance: 30 },
  de: { machine: 500, beans: 16, dose: 18, extra: 0.2, cafe: 3.2, cups: 2, days: 7, maintenance: 40 },
  es: { machine: 400, beans: 18, dose: 14, extra: 0.1, cafe: 1.6, cups: 2, days: 7, maintenance: 30 },
  pl: { machine: 1800, beans: 80, dose: 18, extra: 0.5, cafe: 14, cups: 2, days: 7, maintenance: 150 },
  se: { machine: 5000, beans: 220, dose: 18, extra: 1.5, cafe: 40, cups: 2, days: 7, maintenance: 400 },
};
const v = examples[market]!;
const strings = { never: s.never, daysUnit: s.daysUnit, monthsUnit: s.monthsUnit };
---

<CalcShell ed={ed} calc="home-payback" tool="tool-home-payback" next="tool-brew-ratio" nextHref={pathFor('home', ed)} nextLabel={t(lang).verdict.findMachine} data-strings={JSON.stringify(strings)}>
  <Fragment slot="inputs">
    <div class="grid">
      <Stepper ed={ed} idPrefix="hp" name="machine" label={s.machine} currency value={v.machine} step={10} max={20000} range={[50, 2000]} />
      <Stepper ed={ed} idPrefix="hp" name="cafe" label={s.cafe} currency value={v.cafe} step={0.05} max={50} range={[0.5, 8]} />
      <Stepper ed={ed} idPrefix="hp" name="cups" label={s.cups} value={v.cups} step={1} max={30} range={[1, 8]} />
    </div>
    <Advanced label={t(lang).advanced}>
      <CurrencySwitch ed={ed} />
      <Stepper ed={ed} idPrefix="hp" name="days" label={s.days} value={v.days} step={1} min={1} max={7} range={[1, 7]} />
      <Stepper ed={ed} idPrefix="hp" name="beans" label={s.beans} currency unit="/kg" value={v.beans} step={0.5} max={500} range={[5, 60]} />
      <Stepper ed={ed} idPrefix="hp" name="dose" label={s.dose} unit="g" value={v.dose} step={0.5} max={50} range={[5, 25]} />
      <Stepper ed={ed} idPrefix="hp" name="extra" label={s.extra} currency value={v.extra} step={0.05} max={20} range={[0, 2]} />
      <Stepper ed={ed} idPrefix="hp" name="maintenance" label={s.maintenance} currency value={v.maintenance} step={5} max={5000} range={[0, 200]} />
    </Advanced>
  </Fragment>

  <Fragment slot="results">
    <Readout label={s.paysIn} out="payback" unit={s.monthsUnit} size="xl" primary />
    <p class="verdict" data-out="verdict" hidden></p>
    <div class="bars" aria-hidden="true">
      <div class="row">
        <span class="bl">{s.atHome}</span>
        <span class="track"><span class="fill" data-bar="home"></span></span>
        <span class="bv" data-out="homeBar"></span>
      </div>
      <div class="row">
        <span class="bl">{s.out}</span>
        <span class="track"><span class="fill alt" data-bar="out"></span></span>
        <span class="bv" data-out="outBar"></span>
      </div>
    </div>
    <div class="grid2">
      <Readout label={s.yearly} out="yearly" size="md" />
      <Readout label={s.threeYears} out="threeYears" size="md" />
      <Readout label={s.homeCost} out="homeCost" size="md" />
      <Readout label={s.saving} out="saving" size="md" />
    </div>
  </Fragment>
</CalcShell>

<style>
  .verdict {
    color: var(--bad-lit);
    font-weight: 600;
    line-height: 1.45;
  }
  .bars {
    display: grid;
    gap: 0.6rem;
  }
  .row {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    font: 500 0.75rem/1.2 var(--f-mono);
    color: var(--on-ink-2);
  }
  .track {
    height: 10px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--on-ink) 8%, transparent);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    width: var(--w, 0%);
    background: var(--accent);
    border-radius: 5px;
    transition: width var(--d-3) var(--ease-out);
  }
  .fill.alt {
    background: color-mix(in srgb, var(--on-ink) 42%, transparent);
  }
  .bv {
    color: var(--on-ink);
    min-width: 4.5rem;
    text-align: right;
  }
  .grid2 {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.1rem 1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--ink-line);
  }
</style>

<script>
  import { onCalc, num, allFinite, money, plain, tween, blank, out, bar, currencyOf, announce } from '../../../scripts/calc';

  onCalc('home-payback', (form) => {
    const strings = JSON.parse(form.dataset.strings!);
    const locale = form.dataset.locale!;
    const unitEl = form.querySelector<HTMLElement>('[data-unit-for="payback"]');
    const verdict = out(form, 'verdict')!;

    return () => {
      const m = (x: number) => money(locale, currencyOf(form), x);
      const [machine, beans, dose, extra, cafe, cups, days, maintenance] = ['machine', 'beans', 'dose', 'extra', 'cafe', 'cups', 'days', 'maintenance'].map((n) => num(form, n));
      if (!allFinite(machine, beans, dose, extra, cafe, cups, days, maintenance)) {
        ['payback', 'yearly', 'threeYears', 'homeCost', 'saving'].forEach((k) => blank(out(form, k)));
        return;
      }

      const homeCost = (beans * dose) / 1000 + extra;
      const saving = cafe - homeCost;
      const netYear = saving * cups * days * 52 - maintenance;

      tween(out(form, 'homeCost'), homeCost, m);
      tween(out(form, 'saving'), saving, m);
      tween(out(form, 'yearly'), netYear, m);
      tween(out(form, 'threeYears'), netYear * 3 - machine, m);
      const top = Math.max(homeCost, cafe, 0.0001);
      bar(form, 'home', (homeCost / top) * 100);
      bar(form, 'out', (cafe / top) * 100);
      out(form, 'homeBar')!.textContent = m(homeCost);
      out(form, 'outBar')!.textContent = m(cafe);

      if (netYear <= 0 || cups <= 0) {
        blank(out(form, 'payback'));
        if (unitEl) unitEl.textContent = '';
        verdict.hidden = false;
        verdict.textContent = strings.never;
        announce(form, strings.never);
        return;
      }
      verdict.hidden = true;
      const days_ = machine / (netYear / 365);
      const inDays = days_ < 90;
      if (unitEl) unitEl.textContent = inDays ? strings.daysUnit : strings.monthsUnit;
      const value = inDays ? Math.ceil(days_) : days_ / 30.44;
      tween(out(form, 'payback'), value, (n) => plain(locale, n, inDays ? 0 : 1));
      announce(form, `${plain(locale, value, inDays ? 0 : 1)} ${inDays ? strings.daysUnit : strings.monthsUnit}`);
    };
  });
</script>
