---
// Behind the home hero: the scale display's grid, warmed by a crema glow.
---

<div class="grid-bg" aria-hidden="true"></div>

<style>
  .grid-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(55% 65% at 80% 40%, color-mix(in srgb, var(--accent) 15%, transparent), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--on-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 100% 48px,
      linear-gradient(90deg, color-mix(in srgb, var(--on-ink) 5%, transparent) 1px, transparent 1px) 0 0 / 48px 100%;
    mask-image: radial-gradient(120% 100% at 70% 0%, #000 40%, transparent 85%);
    pointer-events: none;
  }
</style>
