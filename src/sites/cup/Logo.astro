---
// Mark: a coffee bean whose centre crease is a check mark — the "verdict".
interface Props {
  size?: number;
  wordmark?: boolean;
}
const { size = 28, wordmark = true } = Astro.props;
---

<span class="logo">
  <svg width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <ellipse cx="12" cy="12" rx="7.3" ry="9.7" transform="rotate(38 12 12)" fill="var(--accent)"></ellipse>
    <path d="m8.4 12.7 2.5 2.6 4.8-6.1" fill="none" stroke="var(--ink)" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  {
    wordmark && (
      <span class="word">
        <b>Cup</b>Verdict
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }
  .word {
    font-family: var(--f-display);
    font-size: 1.28rem;
    font-weight: 520;
    letter-spacing: -0.045em;
    line-height: 1;
  }
  .word b {
    font-weight: 800;
  }
  svg {
    transition: transform var(--d-3) var(--ease-spring);
  }
  :global(a:hover) > .logo svg {
    transform: rotate(-14deg) scale(1.06);
  }
</style>
