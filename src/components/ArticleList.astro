---
import type { CollectionEntry } from 'astro:content';
import Icon from './ui/Icon.astro';
import { numberLocale, type Edition } from '../i18n/editions';
import { articlePath } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  ed: Edition;
  articles: CollectionEntry<'articles'>[];
}
const { ed, articles } = Astro.props;
const { lang } = ed;
const ui = t(lang).guides;
const date = new Intl.DateTimeFormat(numberLocale(ed), { dateStyle: 'medium' });
---

{
  articles.length === 0 ? (
    <p class="empty">{ui.empty}</p>
  ) : (
    <ol class="list">
      {articles.map((a, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a href={articlePath(ed, a.data.slug)}>
            <span class="n">{String(i + 1).padStart(2, '0')}</span>
            <span class="body">
              <span class="title">{a.data.title}</span>
              <span class="desc">{a.data.description}</span>
            </span>
            <time datetime={a.data.updated.toISOString().slice(0, 10)}>{date.format(a.data.updated)}</time>
            <span class="arrow" aria-hidden="true">
              <Icon name="arrow-right" size={18} />
            </span>
          </a>
        </li>
      ))}
    </ol>
  )
}

<style>
  .empty {
    color: var(--text-3);
    font-family: var(--f-mono);
    font-size: 0.85rem;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto 1.5rem;
    align-items: baseline;
    gap: 1rem;
    padding: 1.3rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition: padding var(--d-3) var(--ease-out);
  }
  a:hover {
    padding-left: 0.5rem;
  }
  .n,
  time {
    font: 500 0.72rem/1 var(--f-mono);
    color: var(--text-3);
  }
  .body {
    display: grid;
    gap: 0.35rem;
  }
  .title {
    font: 700 clamp(1.1rem, 1rem + 0.5vw, 1.35rem) / 1.2 var(--f-display);
    letter-spacing: -0.02em;
  }
  .desc {
    color: var(--text-2);
    font-size: 0.95rem;
  }
  .arrow {
    align-self: center;
    color: var(--accent-ink);
    transition: transform var(--d-3) var(--ease-spring);
  }
  a:hover .arrow {
    transform: translateX(4px);
  }
  @media (max-width: 40rem) {
    a {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
    time,
    .arrow {
      display: none;
    }
  }
</style>
