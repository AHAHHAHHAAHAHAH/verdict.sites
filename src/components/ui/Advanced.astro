---
import Icon from './Icon.astro';

interface Props {
  label: string;
}
const { label } = Astro.props;
---

<details class="adv">
  <summary>
    <span>{label}</span>
    <Icon name="chevron-down" size={16} stroke={2} class="chev" />
  </summary>
  <div class="adv-body">
    <slot />
  </div>
</details>

<style>
  .adv {
    border-top: 1px dashed var(--line);
    padding-top: 1rem;
  }
  summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--text-2);
    cursor: pointer;
    list-style: none;
    transition:
      color var(--d-2) var(--ease-out),
      border-color var(--d-2) var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover,
  .adv[open] summary {
    color: var(--text);
    border-color: var(--line-strong);
  }
  summary :global(.chev) {
    transition: transform var(--d-3) var(--ease-out);
  }
  .adv[open] summary :global(.chev) {
    transform: rotate(180deg);
  }
  .adv-body {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14.5rem), 1fr));
    gap: 1.25rem 1.1rem;
    padding-top: 1.2rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .adv[open] .adv-body {
      animation: adv-in 380ms var(--ease-out);
    }
  }
  @keyframes adv-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
