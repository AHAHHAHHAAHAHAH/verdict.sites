---
// Hand-drawn icon set on a 24px grid, 1.6px round strokes. No icon library.
import { icons as siteIcons } from '@site/icons';
const base: Record<string, string> = {
  source: '<path d="M13.5 3H7a1.5 1.5 0 0 0-1.5 1.5v15A1.5 1.5 0 0 0 7 21h10a1.5 1.5 0 0 0 1.5-1.5V8L13.5 3Z"/><path d="M13.5 3v5h5"/><path d="M9 12.5h6M9 16h4"/>',
  shield: '<path d="M12 3 19 5.8v5.4c0 4.3-2.9 8.1-7 9.8-4.1-1.7-7-5.5-7-9.8V5.8L12 3Z"/><path d="m8.8 12.2 2.2 2.2 4.3-4.6"/>',
  bolt: '<path d="M13.2 2.8 5.5 13.2h5.8l-1 8 8.2-10.6h-6l.7-7.8Z"/>',
  ruler: '<path d="M3.8 16.2 16.2 3.8a1 1 0 0 1 1.4 0l2.6 2.6a1 1 0 0 1 0 1.4L7.8 20.2a1 1 0 0 1-1.4 0l-2.6-2.6a1 1 0 0 1 0-1.4Z"/><path d="m7.2 12.8 1.6 1.6M9.7 10.3l2.3 2.3M12.2 7.8l1.6 1.6M14.7 5.3l2.3 2.3"/>',
  eye: '<path d="M2.5 12s3.5-6.5 9.5-6.5 9.5 6.5 9.5 6.5-3.5 6.5-9.5 6.5S2.5 12 2.5 12Z"/><circle cx="12" cy="12" r="2.8"/>',
  refresh: '<path d="M19.5 12a7.5 7.5 0 0 1-13.2 4.9M4.5 12a7.5 7.5 0 0 1 13.2-4.9"/><path d="M17.7 3.8v3.3h-3.3M6.3 20.2v-3.3h3.3"/>',
  // A price tag: today's deals.
  tag: '<path d="M3.5 12.3V4.5a1 1 0 0 1 1-1h7.8l8.2 8.2a1 1 0 0 1 0 1.4l-7.8 7.8a1 1 0 0 1-1.4 0Z"/><circle cx="8.2" cy="8.2" r="1.5"/>',
  'arrow-right': '<path d="M4 12h15.5M13.5 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  'arrow-up': '<path d="M12 19.5V5M6 11l6-6 6 6"/>',
  'arrow-left': '<path d="M20 12H4.5M10.5 6l-6 6 6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  minus: '<path d="M5 12h14"/>',
  'chevron-down': '<path d="M6.5 9.5 12 15l5.5-5.5"/>',
  globe: '<circle cx="12" cy="12" r="8.8"/><path d="M3.2 12h17.6M12 3.2c2.4 2.5 3.6 5.4 3.6 8.8s-1.2 6.3-3.6 8.8c-2.4-2.5-3.6-5.4-3.6-8.8s1.2-6.3 3.6-8.8Z"/>',
  mail: '<path d="M3.5 6.5h17v11h-17z"/><path d="m3.8 7 8.2 6.2L20.2 7"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  cross: '<path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>',
  external: '<path d="M14 4h6v6M20 4l-8.5 8.5"/><path d="M18 14v4.5a1.5 1.5 0 0 1-1.5 1.5h-11A1.5 1.5 0 0 1 4 18.5v-11A1.5 1.5 0 0 1 5.5 6H10"/>',
  // A map pin: the country you shop in.
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"/><circle cx="12" cy="10" r="2.4"/>',
  calc: '<rect x="5.5" y="3" width="13" height="18" rx="2"/><path d="M8.5 6.5h7v3h-7z"/><path d="M8.8 13h.01M12 13h.01M15.2 13h.01M8.8 16.5h.01M12 16.5h.01M15.2 16.5h.01"/>',
  info: '<circle cx="12" cy="12" r="8.8"/><path d="M12 11v5.5M12 7.8h.01"/>',
  // Rows of a list, for "all models".
  list: '<path d="M9 6.5h11M9 12h11M9 17.5h11"/><path d="M4.5 6.5h.01M4.5 12h.01M4.5 17.5h.01"/>',
  sort: '<path d="M7 4.5v15M3.8 16.3 7 19.5l3.2-3.2"/><path d="M17 19.5v-15M13.8 7.7 17 4.5l3.2 3.2"/>',
  filter: '<path d="M3.5 6h17M6.5 12h11M9.5 18h5"/>',
};

// Base set plus the site's own drawings (coffee makers, robots, dehumidifiers...).
const icons: Record<string, string> = { ...base, ...siteIcons };

export type IconName = string;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  stroke?: number;
}
const { name, size = 24, class: className, stroke = 1.6 } = Astro.props;
if (!icons[name]) throw new Error(`Icon "${name}" is not drawn yet (base set or @site/icons)`);
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={icons[name]}
/>
