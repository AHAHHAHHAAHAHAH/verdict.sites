---
import { getCollection } from 'astro:content';
import Logo from '@site/Logo.astro';
import type { Edition } from '../i18n/editions';
import { pathFor, toolKeys, verdictPath } from '../i18n/routes';
import { t } from '../i18n/ui';
import { site } from '@site/config';
import { tx } from '../lib/pack';
import { publisher, contactEmail } from '../lib/webora';
import { categories, categoryIdsIn } from '../lib/catalog';

interface Props {
  ed: Edition;
}
const { ed } = Astro.props;
const { lang, market } = ed;
const ui = t(lang);
const hasGuides = (await getCollection('articles', (a) => a.data.lang === lang && !a.data.draft)).length > 0;
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <div class="top">
      <div class="id">
        <Logo size={34} />
        <p class="line">{ui.footer.line}</p>
      </div>
      <nav class="cols">
        <div>
          <p class="eyebrow">{ui.menu.types}</p>
          <ul>
            {
              categoryIdsIn(market).map((id) => (
                <li>
                  <a href={verdictPath(ed, tx(categories[id].slug, lang))}>{tx(categories[id].name, lang)}</a>
                </li>
              ))
            }
          </ul>
        </div>
        {
          toolKeys.length > 0 && (
            <div>
              <p class="eyebrow">{ui.nav.tools}</p>
              <ul>
                {toolKeys.map((k) => (
                  <li>
                    <a href={pathFor(k, ed)}>{ui.tools?.short[k]}</a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div>
          <p class="eyebrow">{site.name}</p>
          <ul>
            <li><a href={pathFor('about', ed)}>{ui.footer.about}</a></li>
            {hasGuides && <li><a href={pathFor('guides', ed)}>{ui.nav.guides}</a></li>}
            <li><a href={pathFor('privacy', ed)}>{ui.footer.privacy}</a></li>
            <li><a href={pathFor('legal', ed)}>{ui.footer.legal}</a></li>
            <li><a href={`mailto:${contactEmail}`}>{contactEmail}</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <p class="disclosure">
      {ui.footer.disclosure}
      {site.amazonAssociate && <> {ui.footer.amazon}</>}
    </p>
    <div class="bottom">
      <span>© {year} {site.name}</span>
      <span>{ui.footer.publisher} <a class="pub" href={publisher.url}>{publisher.name}</a></span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    position: relative;
    overflow: hidden;
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
    padding: clamp(3rem, 2rem + 3vw, 4.5rem) 0 clamp(2rem, 1.5rem + 2vw, 3rem);
    background: var(--ink);
    color: var(--on-ink-2);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: 3rem;
  }
  .id {
    color: var(--on-ink);
  }
  .line {
    margin-top: 1rem;
    font: 500 1.05rem/1.45 var(--f-text);
    color: var(--on-ink-2);
    max-width: 26ch;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 2rem;
  }
  .eyebrow {
    color: var(--on-ink-3);
    margin-bottom: 0.9rem;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  a {
    color: var(--on-ink-2);
    text-decoration: none;
    transition: color var(--d-2) var(--ease-out);
    overflow-wrap: anywhere;
  }
  li a {
    display: inline-block;
    padding: 0.45rem 0;
  }
  a:hover {
    color: var(--accent);
  }
  .disclosure {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink-line);
    font-size: 0.85rem;
    max-width: 52rem;
    color: var(--on-ink-3);
  }
  .bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem 1.5rem;
    margin-top: 1.5rem;
    font: 500 0.875rem/1.4 var(--f-text);
    color: var(--on-ink-3);
  }
  .bottom .pub {
    color: var(--on-ink);
    text-decoration: underline;
    text-decoration-color: var(--ink-line);
    text-underline-offset: 0.25em;
  }
  @media (max-width: 48rem) {
    .top {
      grid-template-columns: 1fr;
    }
  }
</style>
