---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import { tag, type Edition } from '../i18n/editions';
import { pathFor, toolKeys, type ToolKey } from '../i18n/routes';
import { t } from '../i18n/ui';
import type { Alternate } from '../lib/types';
import { tools as siteTools } from '@site/tools';
import { toolComponents } from '@site/tool-components';

const toolMeta = siteTools?.meta ?? {};
import { site } from '@site/config';

interface Props {
  ed: Edition;
  alternates: Alternate[];
  tool: ToolKey;
  copy: CollectionEntry<'pages'>;
  related: CollectionEntry<'articles'>[];
}
const { ed, alternates, tool, copy, related } = Astro.props;
const { lang } = ed;
const ui = t(lang);
const tt = ui.tools!;
const { Content } = await render(copy);
const Calculator = (toolComponents as Record<string, any>)[tool];
if (!Calculator) throw new Error(`No calculator component for "${tool}"`);
const meta = toolMeta[tool];
const others = toolKeys.filter((k) => k !== tool);
const url = (p: string) => new URL(p, site.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: tt.names[tool],
    description: copy.data.description,
    url: url(pathFor(tool, ed)),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: tag(ed),
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: site.name, item: url(pathFor('home', ed)) },
      { '@type': 'ListItem', position: 2, name: tt.indexTitle, item: url(pathFor('tools', ed)) },
      { '@type': 'ListItem', position: 3, name: tt.short[tool], item: url(pathFor(tool, ed)) },
    ],
  },
];
---

<Base ed={ed} title={`${copy.data.title} | ${site.name}`} description={copy.data.description} alternates={alternates} jsonLd={jsonLd} noindex>
  <div class="wrap">
    <header class="ph">
      <nav class="crumbs eyebrow" aria-label="Breadcrumb" data-reveal>
        <a href={pathFor('tools', ed)}>{tt.indexTitle}</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{tt.short[tool]}</span>
      </nav>
      <div class="title-row" data-reveal style="--i:1">
        <span class="ic"><Icon name={meta.icon} size={28} stroke={1.5} /></span>
        <h1>{copy.data.title}</h1>
      </div>
      <p class="lede" data-reveal style="--i:2">{copy.data.description}</p>
    </header>

    <Calculator ed={ed} />

    <div class="below">
      <article class="prose" data-reveal>
        <Content />
      </article>
      <aside class="side" data-reveal style="--i:1" aria-label={ui.home.allTools ?? tt.indexTitle} data-more-tools>
        <p class="eyebrow">{ui.home.allTools ?? tt.indexTitle}</p>
        <ul>
          {
            others.map((k) => (
              <li>
                <a href={pathFor(k, ed)}>
                  <span class="mini">
                    <Icon name={toolMeta[k].icon} size={18} stroke={1.6} />
                  </span>
                  <span>{tt.short[k]}</span>
                  <Icon name="arrow-right" size={16} class="arr" />
                </a>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>

    {
      related.length > 0 && (
        <section class="related">
          <SectionHead index="→" label={ui.guides.related} />
          <ArticleList ed={ed} articles={related} />
        </section>
      )
    }
  </div>
</Base>

<style>
  .ph {
    display: grid;
    gap: 1.1rem;
    padding: clamp(2rem, 1.3rem + 3vw, 3.5rem) 0 0;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--text-3);
    text-decoration: none;
    transition: color var(--d-2) var(--ease-out);
  }
  .crumbs a:hover {
    color: var(--accent-ink);
  }
  .crumbs [aria-current] {
    color: var(--text);
  }
  .title-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .ic {
    display: grid;
    place-items: center;
    width: 3.6rem;
    height: 3.6rem;
    flex: none;
    border-radius: var(--r-md);
    background: var(--ink);
    color: var(--accent);
  }
  .below {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 18rem);
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    padding-top: clamp(1rem, 0.5rem + 2vw, 2.5rem);
  }
  .side {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    align-self: start;
    padding-top: 2.4rem;
  }
  .side ul {
    list-style: none;
    margin: 0.9rem 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .side a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .mini {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--r-sm);
    background: var(--ink);
    color: var(--accent);
  }
  .side a :global(.arr) {
    color: var(--text-3);
    transition:
      transform var(--d-3) var(--ease-spring),
      color var(--d-2) var(--ease-out);
  }
  .side a:hover :global(.arr) {
    color: var(--accent-ink);
    transform: translateX(4px);
  }
  .related {
    padding-top: clamp(3rem, 2rem + 3vw, 5rem);
  }
  @media (max-width: 58rem) {
    .below {
      grid-template-columns: 1fr;
    }
    .side {
      position: static;
      padding-top: 0;
    }
  }
</style>
