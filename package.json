{
  "name": "verdict-sites",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run.mjs cup dev",
    "dev:cup": "node scripts/run.mjs cup dev",
    "dev:floor": "node scripts/run.mjs floor dev",
    "dev:clima": "node scripts/run.mjs clima dev",
    "build:cup": "node scripts/run.mjs cup build",
    "build:floor": "node scripts/run.mjs floor build",
    "build:clima": "node scripts/run.mjs clima build",
    "build": "npm run build:cup",
    "build:prod": "node scripts/check-launch.mjs && node scripts/run.mjs cup check && npm run build:cup && npm run build:floor && npm run build:clima",
    "check": "node scripts/run.mjs cup check",
    "preview": "node scripts/run.mjs cup preview",
    "astro": "astro",
    "check:cup": "node scripts/run.mjs cup check",
    "check:floor": "node scripts/run.mjs floor check",
    "preview:floor": "node scripts/run.mjs floor preview",
    "prices": "node scripts/check-prices.mjs cup && node scripts/check-prices.mjs floor && node scripts/check-prices.mjs clima",
    "check:clima": "node scripts/run.mjs clima check",
    "preview:clima": "node scripts/run.mjs clima preview"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/azeret-mono": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/epilogue": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "astro": "^7.3.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "typescript": "^6.0.3"
  }
}
